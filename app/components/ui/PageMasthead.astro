---
import type { ImageMetadata } from "astro";

import BannerBackground from "./BannerBackground.astro";
import Container from "./Container.astro";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Printed beside the description, for example "38 entries". */
  meta?: string;
  /** Widens the measure for pages whose title is a full sentence. */
  size?: "default" | "large";
  /** Decorative photograph; defaults to the AKSC logo when omitted. */
  backgroundImage?: ImageMetadata;
  /** Identifies people shown in an archival background image. */
  backgroundLabel?: string;
  /** Required attribution for a Creative Commons background image. */
  backgroundCredit?: ImageCredit;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  meta,
  size = "default",
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  class: className,
} = Astro.props;

const hasAbove = Astro.slots.has("above");
---

<div
  class:list={[
    "on-dark relative isolate overflow-hidden bg-ambedkar-950 text-white",
    className,
  ]}
>
  <BannerBackground image={backgroundImage} />

  <Container class="pt-14 pb-16 sm:pt-20 sm:pb-24">
    <slot name="above" />

    <div
      class:list={[
        "rise",
        size === "large" ? "max-w-5xl" : "max-w-4xl",
        hasAbove && "mt-10",
      ]}
    >
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1
        class="mt-6 font-display text-display-lg leading-[0.98] font-bold tracking-display text-balance"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-7 max-w-2xl font-serif text-xl leading-[1.65] text-white/75 sm:text-[1.375rem]">
            {description}
          </p>
        )
      }
      {
        meta && (
          <p
            class="mt-8 font-sans text-sm font-semibold text-white/85"
            data-page-meta
          >
            {meta}
          </p>
        )
      }
    </div>

    <slot />

    {
      /*
      Attribution stays in flow even on desktop: enlarged text and long
      licenses must never collide with the heading or a page's actions.
    */
    }
    {
      backgroundImage && (backgroundLabel || backgroundCredit) && (
        <div class="mt-10 max-w-2xl font-sans text-sm leading-6 text-white">
          {backgroundLabel && <p>Pictured: {backgroundLabel}</p>}
          {backgroundCredit && (
            <p class="mt-1">
              Image:{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.sourceHref}
              >
                {backgroundCredit.creator}
              </a>{" "}
              ·{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.licenseHref}
                rel="license"
              >
                {backgroundCredit.license}
              </a>{" "}
              · cropped and recolored
            </p>
          )}
        </div>
      )
    }
  </Container>
</div>
