---
import type { ImageMetadata } from "astro";

import BannerBackground from "./BannerBackground.astro";
import Container from "./Container.astro";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Printed beside the description, for example "38 entries". */
  meta?: string;
  /** Widens the measure for pages whose title is a full sentence. */
  size?: "default" | "large";
  /** Decorative photograph; defaults to the AKSC logo when omitted. */
  backgroundImage?: ImageMetadata;
  /** Identifies people shown in an archival background image. */
  backgroundLabel?: string;
  /** Required attribution for a Creative Commons background image. */
  backgroundCredit?: ImageCredit;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  meta,
  size = "default",
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  class: className,
} = Astro.props;

const hasAbove = Astro.slots.has("above");
---

<div
  class:list={[
    "on-dark relative isolate overflow-hidden bg-ambedkar-950 text-white",
    className,
  ]}
>
  <BannerBackground image={backgroundImage} />

  <Container class="pt-14 pb-16 sm:pt-20 sm:pb-24">
    <slot name="above" />

    <div
      class:list={[
        "rise",
        size === "large" ? "max-w-5xl" : "max-w-4xl",
        hasAbove && "mt-10",
      ]}
    >
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1
        class="mt-6 font-display text-display-lg leading-[0.98] font-bold tracking-display text-balance"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-7 max-w-2xl font-serif text-xl leading-[1.65] text-white/75 sm:text-[1.375rem]">
            {description}
          </p>
        )
      }
      {
        meta && (
          <p
            class="mt-8 font-display text-xs font-semibold tracking-[0.14em] text-white/70 uppercase"
            data-page-meta
          >
            {meta}
          </p>
        )
      }
    </div>

    <slot />

    {
      /*
      The attribution a Creative Commons photograph requires. It is pinned to
      the corner of the panel from `sm`, where there is room for it beside the
      reading column.

      Below that it stays in the flow, under the content it belongs to. Pinning
      it on a phone put a three-line credit on top of the masthead's own meta
      line, because an absolute box cannot know how tall the text above it has
      wrapped to; the two simply printed over each other.
    */
    }
    {
      backgroundImage && (backgroundLabel || backgroundCredit) && (
        <div class="mt-10 sm:absolute sm:right-6 sm:bottom-5 sm:mt-0 sm:max-w-[calc(100%-3rem)] sm:text-right">
          {backgroundLabel && (
            <p class="font-display text-[0.625rem] font-semibold tracking-[0.12em] text-white/90 uppercase [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
              Pictured: {backgroundLabel}
            </p>
          )}
          {backgroundCredit && (
            <p class="mt-1 text-[0.6875rem] leading-4 text-white/85 [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
              Image:{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.sourceHref}
              >
                {backgroundCredit.creator}
              </a>{" "}
              ·{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.licenseHref}
                rel="license"
              >
                {backgroundCredit.license}
              </a>{" "}
              · cropped and recolored
            </p>
          )}
        </div>
      )
    }
  </Container>
</div>
