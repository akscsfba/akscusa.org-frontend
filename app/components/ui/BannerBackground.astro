---
import type { ImageMetadata } from "astro";
import logo from "~/assets/brand/aksc-logo.webp";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
  image?: ImageMetadata;
}

const { image } = Astro.props;
---

<div class="absolute inset-0 -z-20" aria-hidden="true" data-banner-background>
  <ResponsiveImage
    src={image ?? logo}
    alt=""
    class={[
      "absolute right-0 bottom-0 h-auto max-h-full w-auto max-w-full [mask-image:linear-gradient(to_top,black_58%,transparent_100%)]",
      "lg:h-full lg:max-w-none lg:[mask-image:linear-gradient(to_right,transparent_0%,black_34%)]",
      image ? "duotone" : "",
    ].join(" ")}
    loading="eager"
    sizes="100vw"
    widths={[480, 768, 960, 1237, 1600]}
  />
  {image && <div class="absolute inset-0 bg-ambedkar-800 mix-blend-color" />}
</div>
<div
  class="absolute inset-0 -z-10 bg-linear-to-b from-ambedkar-1000/94 via-ambedkar-950/82 via-60% to-ambedkar-950/50 lg:bg-linear-to-r lg:from-ambedkar-1000/95 lg:from-30% lg:via-ambedkar-950/70 lg:via-50% lg:to-ambedkar-950/38"
  aria-hidden="true"
>
</div>
<div class="absolute inset-0 -z-10 grain opacity-[0.035]" aria-hidden="true">
</div>
