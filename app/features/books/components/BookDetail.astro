---
import Container from "~/components/ui/Container.astro";
import EntryHeader from "~/components/ui/EntryHeader.astro";
import Poster from "~/components/ui/Poster.astro";
import ResponsiveImage from "~/components/ui/ResponsiveImage.astro";
import { formatPacificDate } from "~/lib/dates";
import { loadTermLabels } from "~/features/editorial/queries/taxonomy";
import AuthorByline from "~/features/authors/components/AuthorByline.astro";
import { COVER_ALT, COVER_WIDTHS } from "~/features/books/covers";
import { openLibraryUrl } from "~/features/books/isbn";
import { bookAuthorLinks } from "~/features/books/presenters";
import type { BookWithReadings } from "~/features/books/queries/books";

interface Props {
  entry: BookWithReadings;
}

const { entry } = Astro.props;
const { book, readings } = entry;
const { data } = book;

const authors = bookAuthorLinks(entry);
const cover = data.cover;

const facts = [
  data.publisher ? { term: "Publisher", description: data.publisher } : null,
  data.publishedYear
    ? { term: "Edition", description: String(data.publishedYear) }
    : null,
  data.firstPublishedYear
    ? { term: "First published", description: String(data.firstPublishedYear) }
    : null,
].filter((fact) => fact !== null);

const hasFacts = facts.length > 0 || data.isbn !== undefined;

const topicLabel = await loadTermLabels("topics");
---

<article>
  <Container class="pt-10 pb-20 sm:pt-12 sm:pb-28">
    <div
      class:list={[
        "grid grid-cols-1 items-start gap-x-10 gap-y-6",
        cover && "lg:grid-cols-[minmax(0,1fr)_14rem]",
      ]}
    >
      <div class="min-w-0 lg:col-start-1">
        <EntryHeader
          eyebrow="Book"
          title={data.title}
          backHref="/books/"
          backLabel="Books"
        >
          {
            data.subtitle && (
              <p class="mt-4 max-w-2xl font-display text-xl text-ink-muted italic">
                {data.subtitle}
              </p>
            )
          }
          {
            authors.length > 0 && (
              <p class="mt-5 text-lg font-semibold text-ambedkar-900/80">
                By <AuthorByline authors={authors} />
              </p>
            )
          }
        </EntryHeader>
      </div>

      {
        cover && (
          <figure class="lg:col-start-2 lg:row-span-3 lg:row-start-1">
            <ResponsiveImage
              class="w-40 rounded-md sm:w-48 lg:w-56"
              src={cover}
              alt={COVER_ALT}
              sizes="(min-width: 1024px) 14rem, (min-width: 640px) 12rem, 10rem"
              widths={COVER_WIDTHS}
              loading="eager"
            />
            <figcaption class="mt-3 max-w-56 text-xs text-ambedkar-900/70">
              {data.coverSource ? (
                <>
                  Cover art via{" "}
                  <a
                    class="underline underline-offset-2 hover:text-ambedkar-900"
                    href={data.coverSource.url}
                  >
                    {data.coverSource.label}
                  </a>
                  .
                </>
              ) : (
                <>Cover of the edition the circle read.</>
              )}
            </figcaption>
          </figure>
        )
      }

      {
        data.summary && (
          <p class="max-w-2xl font-serif text-xl leading-[1.6] text-ambedkar-900/80 lg:col-start-1">
            {data.summary}
          </p>
        )
      }

      {
        hasFacts && (
          <dl class="card mt-4 grid max-w-3xl grid-cols-1 gap-x-8 gap-y-5 p-6 sm:grid-cols-2 sm:p-8 lg:col-start-1">
            {facts.map((fact) => (
              <div>
                <dt class="label text-ambedkar-700">{fact.term}</dt>
                <dd class="mt-1 leading-7 text-ambedkar-900/80">
                  {fact.description}
                </dd>
              </div>
            ))}
            {data.isbn && (
              <div>
                <dt class="label text-ambedkar-700">ISBN</dt>
                <dd class="mt-1 leading-7 wrap-break-word text-ambedkar-900/80">
                  <a
                    class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                    href={openLibraryUrl(data.isbn)}
                  >
                    {data.isbn}
                  </a>
                  <span class="mt-1 block text-sm text-ambedkar-900/70">
                    Look this edition up on Open Library.
                  </span>
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </div>

    <section class="mt-12 max-w-3xl">
      <h2
        class="font-display text-display-sm leading-[1.04] font-bold tracking-display text-ambedkar-950"
      >
        {
          readings.length === 0
            ? "No sessions yet"
            : readings.length === 1
              ? "One session"
              : `${readings.length} sessions`
        }
      </h2>
      {
        readings.length === 0 ? (
          <p class="mt-4 leading-7 text-ambedkar-900/75">
            The circle has not scheduled a session on this book yet.
          </p>
        ) : (
          <ul class="mt-6 divide-y divide-rule border-t border-rule">
            {readings.map((reading) => (
              <li class="gap-6 py-6 sm:flex sm:items-start">
                {reading.data.posters.length > 0 && (
                  <div class="mb-4 flex gap-3 sm:mb-0 sm:w-36 sm:shrink-0 sm:flex-col">
                    {reading.data.posters.map((poster, index) => (
                      <Poster
                        class="w-28 sm:w-full"
                        src={poster.src}
                        alt={poster.alt}
                        caption={poster.caption}
                        loading={index === 0 ? "eager" : "lazy"}
                      />
                    ))}
                  </div>
                )}
                <div class="relative min-w-0 flex-1">
                  <p class="label text-ambedkar-700">
                    <time datetime={reading.data.date.toISOString()}>
                      {formatPacificDate(reading.data.date)}
                    </time>
                  </p>
                  <h3 class="mt-2 font-display text-xl leading-[1.18] font-semibold tracking-title text-ambedkar-950">
                    <a
                      class="after:absolute after:inset-0"
                      href={`/book-readings/${reading.id}/`}
                    >
                      {reading.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 leading-7 text-ambedkar-900/75">
                    {reading.data.summary}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      data.resources.length > 0 && (
        <section class="card mt-12 max-w-3xl p-6 sm:p-8">
          <h2 class="font-display text-xl font-semibold tracking-title text-ambedkar-950">
            Where to read it
          </h2>
          <ul class="mt-4 space-y-3">
            {data.resources.map((resource) => (
              <li>
                <a
                  class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                  href={resource.url}
                >
                  {resource.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.topics.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="eyebrow">Topics</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {data.topics.map((topic) => (
              <li class="tag px-3 py-1.5 text-sm">{topicLabel(topic)}</li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</article>
