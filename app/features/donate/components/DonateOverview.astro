---
import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";
import ProseContent from "~/features/editorial/components/ProseContent.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  donationLabel: string;
  donationUrl: string;
  sourceUrl?: string;
}

const { title, eyebrow, intro, donationLabel, donationUrl, sourceUrl } =
  Astro.props;
---

<section>
  <!-- The lower masthead now carries controls; keep their text and focus ring clear of the logo's lightest pixels. -->
  <PageMasthead
    {eyebrow}
    {title}
    description={intro}
    class="[&_[data-banner-background]]:opacity-75 lg:[&_[data-banner-background]]:opacity-100"
  >
    <div class="mt-6 max-w-xl">
      <p class="text-sm leading-6 text-white/85">
        If your employer offers matching gifts, donate through its company
        portal. Otherwise, use AKSC's direct donation link.
      </p>
      <a class="btn btn-primary mt-4 min-h-11" href={donationUrl}>
        {donationLabel}
      </a>
    </div>
  </PageMasthead>

  <Container class="pt-12 pb-20 sm:pt-16 sm:pb-28">
    <div
      class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14"
    >
      <div class="min-w-0">
        <ProseContent>
          <slot />
        </ProseContent>

        {
          sourceUrl && (
            <p class="mt-10 max-w-3xl text-sm wrap-break-word text-ambedkar-900/70">
              Originally published at{" "}
              <a
                class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                href={sourceUrl}
                data-provenance
              >
                {sourceUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
              .
            </p>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24" aria-label="Membership">
        <!--
          Money is the smaller half of the ask. AKSC is built by its members,
          and a reader who has come this far intending to help should be told
          that the more useful thing is available to them.
        -->
        <section class="card h-auto p-6">
          <p class="eyebrow">A stronger commitment</p>
          <h2
            class="mt-4 font-display text-2xl leading-[1.12] font-semibold tracking-title text-ambedkar-950"
          >
            Join as a member
          </h2>
          <p class="mt-3 leading-7 text-ambedkar-900/75">
            Members set AKSC's direction and carry its work. Dues start at $20 a
            year, and a membership base is what a donation cannot buy.
          </p>
          <a class="btn btn-outline mt-5" href="/join/"> Join AKSC </a>
        </section>
      </aside>
    </div>
  </Container>
</section>
