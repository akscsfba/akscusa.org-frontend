---
import Container from "~/components/ui/Container.astro";
import BannerBackground from "~/components/ui/BannerBackground.astro";
import type { HomePageData } from "~/features/home/content";

interface Props {
  hero: HomePageData["hero"];
}

const { hero } = Astro.props;
---

<section
  class="on-dark relative isolate flex min-h-120 flex-col justify-end overflow-hidden bg-ambedkar-950 sm:min-h-136 lg:min-h-152"
>
  <BannerBackground />

  <Container class="pt-16 pb-14 sm:pt-20 sm:pb-16">
    <div class="rise max-w-5xl lg:max-w-[54%]">
      <p class="eyebrow eyebrow-light">{hero.eyebrow}</p>
      <!--
        The measure is held to about eight characters from `lg` so the title
        sets as three lines — "Educate," / "Organize" / "& Agitate" — which is
        also how it already broke on a phone, so the shape is the same at every
        width. The ampersand belongs to the word after it: a line that ends on
        "&" leaves it hanging on nothing. The break is set here rather than in
        the Markdown because where a line turns is typography, and the copy in
        app/content should stay a sentence.
      -->
      <h1
        class="mt-7 font-display text-display-xl leading-[0.9] font-bold tracking-display text-balance text-white lg:max-w-[8ch] lg:text-pretty"
      >
        {hero.title}
      </h1>
      <p
        class="mt-8 max-w-2xl font-serif text-xl leading-[1.6] text-white/80 sm:text-2xl"
      >
        {hero.description}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn btn-primary" href={hero.primaryAction.href}>
          {hero.primaryAction.label}
        </a>
        <a class="btn btn-outline-light" href={hero.secondaryAction.href}>
          {hero.secondaryAction.label}
        </a>
      </div>
    </div>
  </Container>
</section>
